{
    "manifest-version": 3,
    "name": "capell-app/insights",
    "slug": "insights",
    "displayName": "Insights",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "preview",
    "description": "Counts page views, clicks and campaign visits on your own site, asks UK, EEA and Swiss visitors for consent, and shows the results in the admin.",
    "product": {
        "group": "Capell Marketing & Growth",
        "tier": "free",
        "bundle": "marketing-growth"
    },
    "namespace": "Capell\\Insights",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend"
        ],
        "supports": ["capell-app/privacy-center"],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\Insights\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": [],
        "runtime": ["Capell\\Insights\\Providers\\InsightsServiceProvider"],
        "admin": ["Capell\\Insights\\Providers\\AdminServiceProvider"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\Insights\\Manifest\\InsightsAdminPageContribution",
            "pageClass": "Capell\\Insights\\Filament\\Pages\\InsightsPage",
            "labelKey": "capell-insights::settings.fieldset",
            "permission": "View:InsightsPage"
        },
        {
            "type": "dashboard-widget",
            "class": "Capell\\Insights\\Manifest\\InsightsDashboardFilamentWidgetsContribution",
            "widgetClasses": [
                "Capell\\Insights\\Filament\\Widgets\\InsightsOverviewStatsFilamentWidget",
                "Capell\\Insights\\Filament\\Widgets\\PopularPagesFilamentWidget",
                "Capell\\Insights\\Filament\\Widgets\\TrendingPagesFilamentWidget",
                "Capell\\Insights\\Filament\\Widgets\\LiveInsightsStatsFilamentWidget",
                "Capell\\Insights\\Filament\\Widgets\\RecentJourneysFilamentWidget",
                "Capell\\Insights\\Filament\\Widgets\\TopActionsFilamentWidget",
                "Capell\\Insights\\Filament\\Widgets\\AcquisitionSourcesFilamentWidget"
            ]
        },
        {
            "type": "overview-stat",
            "class": "Capell\\Insights\\Manifest\\InsightsOverviewStatsContribution",
            "keys": [
                "overview-stat:insights_overview.page-views",
                "overview-stat:insights_overview.unique-visits",
                "overview-stat:insights_overview.clicks"
            ]
        },
        {
            "type": "model",
            "class": "Capell\\Insights\\Manifest\\InsightsModelsContribution",
            "modelClasses": [
                "Capell\\Insights\\Models\\InsightsVisit",
                "Capell\\Insights\\Models\\InsightsConsent",
                "Capell\\Insights\\Models\\InsightsEvent",
                "Capell\\Insights\\Models\\InsightsDailyRollup"
            ]
        },
        {
            "type": "route",
            "class": "Capell\\Insights\\Manifest\\InsightsRoutesContribution",
            "routes": [
                "capell-insights.events",
                "capell-insights.consent",
                "capell-insights.consent-policy"
            ],
            "prefix": "capell/insights",
            "methods": ["POST", "GET"],
            "middleware": ["throttle:30,1"],
            "csrfExempt": true
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\Insights\\Manifest\\InsightsPurgeScheduleContribution",
            "command": "insights:purge",
            "name": "capell-insights-purge",
            "frequency": "monthly"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\Insights\\Manifest\\InsightsDailyRollupsScheduleContribution",
            "command": "insights:rollups:rebuild",
            "name": "capell-insights-daily-rollups",
            "frequency": "daily"
        },
        {
            "type": "console-command",
            "class": "Capell\\Insights\\Manifest\\InsightsConsoleCommandsContribution",
            "commands": ["insights:purge", "insights:rollups:rebuild"],
            "commandClasses": [
                "Capell\\Insights\\Console\\Commands\\PurgeInsightsDataCommand",
                "Capell\\Insights\\Console\\Commands\\RebuildInsightsDailyRollupsCommand"
            ]
        },
        {
            "type": "setting",
            "class": "Capell\\Insights\\Manifest\\InsightsSettingsContribution",
            "settingsClass": "Capell\\Insights\\Settings\\InsightsSettings",
            "settingsGroup": "insights"
        },
        {
            "type": "health-check",
            "class": "Capell\\Insights\\Manifest\\InsightsHealthContribution",
            "checkClass": "Capell\\Insights\\Health\\InsightsHealthCheck"
        },
        {
            "type": "migration",
            "class": "Capell\\Insights\\Manifest\\InsightsMigrationsContribution",
            "tables": [
                "insights_visits",
                "insights_consents",
                "insights_events",
                "insights_daily_rollups",
                "insights_daily_visitors"
            ],
            "migrationFiles": [
                "2026_05_10_190855_01_create_insights_visits_table",
                "2026_05_10_190855_02_create_insights_consents_table",
                "2026_05_10_190855_03_create_insights_events_table",
                "2026_05_10_190855_05_import_legacy_page_views",
                "2026_06_06_000001_create_insights_daily_rollups_table",
                "2026_07_22_000001_add_path_digest_to_insights_daily_rollups_table",
                "2026_09_25_000001_invalidate_legacy_insights_html_cache",
                "2026_11_12_000001_add_dedupe_key_to_insights_events_table",
                "2026_11_12_000002_strip_query_strings_from_insights_visit_urls",
                "2026_11_12_000003_add_visitor_hash_and_sample_weight_to_insights_visits_table",
                "2026_11_12_000004_create_insights_daily_visitors_table"
            ]
        }
    ],
    "database": {
        "migrations": true,
        "settings": true,
        "requiredTables": [
            "insights_visits",
            "insights_consents",
            "insights_events",
            "insights_daily_rollups",
            "insights_daily_visitors"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "purge": "insights:purge",
        "rebuildRollups": "insights:rollups:rebuild",
        "maintenance": ["insights:purge", "insights:rollups:rebuild"]
    },
    "settings": ["Capell\\Insights\\Settings\\InsightsSettings"],
    "permissions": ["View:InsightsPage"],
    "capabilities": [
        "insights",
        "insights-admin",
        "insights-frontend",
        "insights-privacy-center-mirror",
        "beacon"
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "GET /capell/insights/consent-policy (capell-insights.consent-policy)",
                "GET /screenshot-fixtures/insights/{screen}",
                "POST /capell/insights/consent (capell-insights.consent)",
                "POST /capell/insights/events (capell-insights.events)"
            ],
            "auth": "public",
            "csrfExemptRoutes": [
                "POST /capell/insights/consent (capell-insights.consent)",
                "POST /capell/insights/events (capell-insights.events)"
            ],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "GET /capell/insights/consent-policy (capell-insights.consent-policy)",
                "POST /capell/insights/consent (capell-insights.consent)",
                "POST /capell/insights/events (capell-insights.events)"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [
                "insights_consents.ip_hash",
                "insights_consents.user_agent_hash",
                "insights_visits.ip_hash",
                "insights_visits.user_agent_hash",
                "insights_visits.visitor_hash"
            ],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": ["View:InsightsPage"]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["insights"],
        "cacheSafety": {
            "cacheable": true,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\Site",
                    "events": ["saved", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "insights.package-health",
            "label": "Insights package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\Insights\\Health\\InsightsHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Your own page view and click counts, with a consent banner for UK, EEA and Swiss visitors, and reports in the admin.",
        "description": "Insights keeps visit statistics inside your Capell site. It records page views and clicks for each site and language, notes which campaign link or other site sent a visitor, and shows seven dashboard cards plus a full report page. Staff can compare any period of up to a year with the one before. Visitors in the UK, the EEA and Switzerland see a consent banner first, and tracking waits for their answer. A first-party cookie remembers the visit and any consent answer for up to a year. Works with Privacy Centre when you have it. Needs background jobs running on your server.",
        "problem": "You can't tell which pages get read without adding another analytics service.",
        "outcome": "Popular pages, trending pages and visit sources in your admin, counted by your own site.",
        "faq": [
            {
                "question": "Does my visitor data go to an outside analytics company?",
                "answer": "No. Page views, clicks and consent choices are stored in your own site's database, and nothing is sent to an outside analytics service."
            },
            {
                "question": "Why are my totals lower than the number of people who visit?",
                "answer": "Visitors who say no to counting are left out, and so are browsers that send a Do Not Track or Global Privacy Control signal. Known bots and crawlers are skipped too, so treat the totals as a floor."
            },
            {
                "question": "Can I use my own cookie banner instead of the built-in one?",
                "answer": "Yes. You can switch the built-in banner off and pass your visitors' choices to Insights through its browser script, which your developer sets up. Switching the banner off does not give Insights permission to count anyone."
            },
            {
                "question": "How long are the records kept?",
                "answer": "Records older than a year are deleted automatically by default, and you can change that period. The clean-up relies on background jobs, which your developer or host keeps running."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Marketplace card titled Insights with a settings panel and a public page beside the words Collect, Consent and Learn.",
                "caption": "The Marketplace card for Insights, which counts page views, clicks and consent choices."
            },
            {
                "path": "docs/screenshots/insights-settings-screen.png",
                "alt": "Insights settings panel with Enable insights switched on and Require consent for all regions switched off.",
                "caption": "Turn counting on, or ask every visitor for consent whatever country they are in."
            },
            {
                "path": "docs/screenshots/frontend-page-with-tracker-active.png",
                "alt": "Full public home page of an example consultancy with feature cards, a search box, article cards and a footer.",
                "caption": "Counting runs behind a page like this one and adds nothing visitors can see."
            },
            {
                "path": "docs/screenshots/consent-banner-flow.png",
                "alt": "Example consultancy home page with a privacy banner offering Accept all, Reject non-essential and Manage choices.",
                "caption": "A visitor in a region that asks first sees this banner before anything is counted."
            },
            {
                "path": "docs/screenshots/frontend-page-with-tracker-active-real.png",
                "alt": "The same example home page with a logo, a dark-mode button and a search icon in the header.",
                "caption": "A second view of an example public page, where counting leaves no visible mark.",
                "required": true
            }
        ],
        "categories": ["admin", "frontend", "growth"]
    },
    "contributionTraceability": {
        "deferredContributions": [],
        "runtimeIntegrations": {
            "metricCollectors": [
                "Capell\\Insights\\Metrics\\InsightsTrafficMetricsCollector"
            ]
        },
        "contributions": [
            {
                "type": "admin-action-extender",
                "key": "marketing-action:insights.performance",
                "providerBucket": "admin"
            },
            {
                "type": "render-hook",
                "key": "insights-tracker",
                "providerBucket": "runtime"
            }
        ]
    }
}
